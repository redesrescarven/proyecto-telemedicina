# Usar una imagen base de Node.js ligera para el backend
FROM node:20-alpine

# Instalar dependencias del sistema necesarias para Puppeteer/Chromium en Alpine
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    libxshmfence \
    mesa-gbm \
    libc6-compat \
    && update-ca-certificates

# Establecer el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiar package.json y package-lock.json (si existe) para instalar dependencias
COPY package*.json ./

# Instalar las dependencias de Node.js
RUN npm install

# Configurar Puppeteer para usar Chromium del sistema
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV CHROME_PATH=/usr/bin/chromium-browser

# Copiar el resto del código de la aplicación (src y config)
COPY src ./src
COPY config ./config

# Crear directorio para assets (logos, etc.)
RUN mkdir -p /app/assets

# Exponer el puerto en el que la aplicación escuchará (dentro del contenedor)
EXPOSE 4000

# Comando para iniciar la aplicación cuando el contenedor se ejecute
CMD ["npm", "start"]

