// clean-firebase.js
const admin = require('firebase-admin');

// Inicializar Firebase Admin (usa tu serviceAccountKey.json)
const serviceAccount = require('../config/serviceAccountKey.json');

admin.initializeApp({
  credential: admin.credential.cert(serviceAccount)
});

const db = admin.firestore();
const appId = 'default-app-id';

async function deleteCollection(collectionPath, batchSize = 100) {
  const collectionRef = db.collection(collectionPath);
  const query = collectionRef.orderBy('__name__').limit(batchSize);
  
  return new Promise((resolve, reject) => {
    deleteQueryBatch(query, resolve).catch(reject);
  });
}

async function deleteQueryBatch(query, resolve) {
  const snapshot = await query.get();
  
  const batchSize = snapshot.size;
  if (batchSize === 0) {
    resolve();
    return;
  }
  
  const batch = db.batch();
  snapshot.docs.forEach((doc) => {
    batch.delete(doc.ref);
  });
  
  await batch.commit();
  console.log(`✅ Eliminados ${batchSize} documentos de ${query._queryOptions.collectionPath}`);
  
  // Recursivamente eliminar el siguiente lote
  process.nextTick(() => {
    deleteQueryBatch(query, resolve);
  });
}

async function cleanDatabase() {
  console.log('🧹 Iniciando limpieza de Firebase...');
  console.log('⚠️  Esto eliminará TODOS los datos de prueba:');
  console.log('   - Emergencias');
  console.log('   - Sesiones de telemedicina');
  console.log('   - Mensajes de chat');
  console.log('   - Logs de email');
  console.log('   - WebView logs');
  console.log('');
  console.log('🔒 Los siguientes datos NO serán afectados:');
  console.log('   - Usuarios del sistema (systemUsers)');
  console.log('   - Perfiles de usuarios (users)');
  console.log('   - Configuración (config)');
  console.log('   - Términos y condiciones');
  console.log('');
  console.log('⏳ Espera 5 segundos para confirmar... (Ctrl+C para cancelar)');
  
  await new Promise(resolve => setTimeout(resolve, 5000));
  
  try {
    // 1. Eliminar emergencias
    console.log('\n📋 Eliminando emergencias...');
    await deleteCollection(`artifacts/${appId}/public/data/emergencyRequests`);
    
    // 2. Eliminar sesiones de telemedicina y sus mensajes
    console.log('\n📋 Eliminando sesiones de telemedicina...');
    const sessionsRef = db.collection(`artifacts/${appId}/public/data/telemedicineSessions`);
    const sessions = await sessionsRef.get();
    
    for (const session of sessions.docs) {
      // Eliminar mensajes de la sesión
      await deleteCollection(`artifacts/${appId}/public/data/telemedicineSessions/${session.id}/messages`);
      // Eliminar la sesión
      await session.ref.delete();
      console.log(`   ✅ Sesión ${session.id} eliminada`);
    }
    
    // 3. Eliminar logs de email
    console.log('\n📋 Eliminando logs de email...');
    await deleteCollection(`artifacts/${appId}/emailLogs`);
    
    // 4. Eliminar webviewLogs (colección raíz)
    console.log('\n📋 Eliminando webview logs...');
    await deleteCollection('webviewLogs');
    
    console.log('\n🎉 Limpieza completada exitosamente!');
    
  } catch (error) {
    console.error('\n❌ Error durante la limpieza:', error);
  }
  
  process.exit(0);
}

cleanDatabase();
