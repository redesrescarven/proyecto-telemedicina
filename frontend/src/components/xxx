// src/components/PrescriptionModal.jsx
import React, { useState } from 'react';
// ✅ Firebase v9+ modular imports
import { collection, addDoc } from 'firebase/firestore';
// Autocompletar Principio Activo Medicamentos
import PrincipioActivoAutocomplete from './PrincipioActivoAutocomplete';

// ✅ DATOS DEL MÉDICO (TEMPORALES - sin hardcodeos sensibles)
const TEMPORARY_DOCTOR_DATA = {
  id: process.env.REACT_APP_DOCTOR_ID || 'temp-doctor-123',
  name: "Dr. Juan Pérez (Ejemplo)",
  license: "COL-12345",
  ministryReg: "MS-67890",
  signatureUrl: "https://via.placeholder.com/150x50?text=Firma+Medico"
};

// ✅ AGREGAR ESTA LÍNEA:
const APP_NAME = 'RESCARVEN Sistema TeleMedicina';

const PrescriptionModal = ({
  show,
  onClose,
  sessionId,
  patientData,
  db,
  appId,
  setToast,
  backendUrl
}) => {
  const [prescriptionType, setPrescriptionType] = useState('medication');
  const [medications, setMedications] = useState([
    { name: '', dosage: '', duration: '', instructions: '', isSpecial: false }
  ]);
  const [paraclinicalText, setParaclinicalText] = useState('');
  const [additionalEmail, setAdditionalEmail] = useState('');
  const [isSending, setIsSending] = useState(false);
  const [showPreview, setShowPreview] = useState(false);
  const [previewContent, setPreviewContent] = useState(null);
  const [prescriptionNumber, setPrescriptionNumber] = useState(null);

  // --- Lógica de Medicamentos ---
  const handleAddMedication = () => {
    setMedications([...medications, { name: '', dosage: '', duration: '', instructions: '', isSpecial: false }]);
  };

  const handleRemoveMedication = (index) => {
    const newMeds = medications.filter((_, i) => i !== index);
    setMedications(newMeds.length > 0 ? newMeds : [{ name: '', dosage: '', duration: '', instructions: '', isSpecial: false }]);
  };

  const handleMedChange = (index, field, value) => {
    const newMeds = [...medications];
    newMeds[index][field] = value;
    setMedications(newMeds);
  };

  const handleSpecialToggle = (index) => {
    const newMeds = [...medications];
    newMeds[index].isSpecial = !newMeds[index].isSpecial;
    setMedications(newMeds);
  };

  // ✅ GENERAR VISTA PREVIA
  const generatePreview = async () => {
    if (!patientData?.name || !patientData?.cedula) {
      setToast({ message: "Faltan datos del paciente", type: 'error' });
      return;
    }
    setIsSending(true);
    try {
      const numberRes = await fetch('/api/prescriptions/next-number', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ appId })
      });
      const numberData = await numberRes.json();

      if (!numberData.success) throw new Error(numberData.message);

      const baseNumber = numberData.prescriptionNumber;
      setPrescriptionNumber(baseNumber);

      const normalMeds = medications.filter(m => m.name && !m.isSpecial);
      const specialMeds = medications.filter(m => m.name && m.isSpecial);

      let recipeCount = 0;
      if (normalMeds.length > 0) recipeCount++;
      if (specialMeds.length > 0) recipeCount++;
      if (prescriptionType === 'paraclinical' && paraclinicalText.trim()) recipeCount++;

      let content = `${APP_NAME} - RESUMEN DE RECETAS\n`;
      content += '==============================\n\n';
      content += `Paciente: ${patientData.name}\n`;
      content += `Cédula: ${patientData.cedula}\n`;
      content += `Total de recetas a generar: ${recipeCount}\n\n`;

      let currentNum = baseNumber;

      if (normalMeds.length > 0) {
        content += `📋 RECETA N° ${currentNum} - Medicamentos Generales\n`;
        content += '----------------------------------------\n';
        normalMeds.forEach((med, i) => {
          content += `${i + 1}. ${med.name}\n`;
          content += `   Dosis: ${med.dosage} | Duración: ${med.duration}\n`;
          content += `   Indicaciones: ${med.instructions}\n\n`;
        });
        currentNum++;
      }

      if (specialMeds.length > 0) {
        content += `🚨 RECETA N° ${currentNum} - Medicamentos Especiales\n`;
        content += '----------------------------------------\n';
        specialMeds.forEach((med, i) => {
          content += `${i + 1}. ${med.name}\n`;
          content += `   Dosis: ${med.dosage} | Duración: ${med.duration}\n`;
          content += `   Indicaciones: ${med.instructions}\n\n`;
        });
        currentNum++;
      }

      if (prescriptionType === 'paraclinical' && paraclinicalText.trim()) {
        content += `🔬 RECETA N° ${currentNum} - Exámenes Paraclínicos\n`;
        content += '----------------------------------------\n';
        content += paraclinicalText + '\n';
        currentNum++;
      }

      setPreviewContent(content);
      setShowPreview(true);

    } catch (error) {
      console.error("Error generando preview:", error);
      setToast({ message: 'Error: ' + error.message, type: 'error' });
    } finally {
      setIsSending(false);
    }
  };

  // ✅ CONFIRMAR Y ENVIAR
  const confirmAndSend = async () => {
    setIsSending(true);
    try {
      const normalMeds = medications.filter(m => m.name && !m.isSpecial);
      const specialMeds = medications.filter(m => m.name && m.isSpecial);

      const payload = {
        prescriptionNumber,
        type: prescriptionType,
        sessionId,
        historyPhase: 'telemedicine',
        doctor: TEMPORARY_DOCTOR_DATA,
        patient: {
          name: patientData.name,
          cedula: patientData.cedula
        },
        medications: normalMeds,
        specialMedications: specialMeds,
        paraclinicalStudies: prescriptionType === 'paraclinical' ? paraclinicalText : '',
        emails: [patientData.email, additionalEmail].filter(Boolean)
      };

      const prescriptionsRef = collection(db, 'artifacts/' + appId + '/public/data/prescriptions');
      await addDoc(prescriptionsRef, {
        ...payload,
        createdAt: new Date(),
        status: 'sent',
        isBatch: normalMeds.length > 0 && (specialMeds.length > 0 || prescriptionType === 'paraclinical')
      });

      const sendRes = await fetch('/api/prescriptions/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const sendData = await sendRes.json();

      if (sendData.success) {
        const recipeNumbers = sendData.recipeNumbers || [prescriptionNumber];
        const count = recipeNumbers.length;

        let message = `✅ ${count} receta(s) generada(s) y enviada(s).`;
        if (count > 1) {
          message += ` (N° ${recipeNumbers.join(', ')})`;
        }

        setToast({ message, type: 'success' });
        handleClose();
      } else {
        throw new Error(sendData.message || "Error en el servidor");
      }

    } catch (error) {
      console.error("Error enviando recetas:", error);
      setToast({ message: '❌ Error: ' + error.message, type: 'error' });
    } finally {
      setIsSending(false);
    }
  };

  const handleClose = () => {
    setShowPreview(false);
    setPreviewContent(null);
    setPrescriptionNumber(null);
    onClose();
  };

  if (!show) return null;

  // ✅ VISTA DE PREVIEW
  if (showPreview && previewContent) {
    return (
      <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div className="bg-white rounded-lg w-full max-w-2xl h-[90vh] flex flex-col shadow-2xl">
          <div className="p-4 border-b flex justify-between items-center bg-indigo-700 text-white rounded-t-lg">
            <h3 className="text-xl font-bold">📄 Vista Previa - Recipe #{prescriptionNumber}</h3>
            <button onClick={handleClose} className="text-white hover:text-gray-200 text-2xl">×</button>
          </div>
          <div className="flex-1 overflow-auto p-6 bg-gray-100">
            <pre className="whitespace-pre-wrap font-mono text-sm bg-white p-4 rounded border">
              {previewContent}
            </pre>
          </div>
          <div className="p-4 border-t bg-gray-50 flex justify-end gap-3 rounded-b-lg">
            <button
              onClick={() => setShowPreview(false)}
              className="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium"
            >
              ← Editar
            </button>
            <button
              onClick={confirmAndSend}
              disabled={isSending}
              className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium disabled:opacity-50 flex items-center gap-2"
            >
              {isSending ? (
                <>
                  <svg className="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                    <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Enviando...
                </>
              ) : (
                '✅ Confirmar y Enviar Recipe'
              )}
            </button>
          </div>
        </div>
      </div>
    );
  }

  // ✅ VISTA DE EDICIÓN (Formulario)
  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4 overflow-y-auto">
      <div className="bg-white rounded-lg w-full max-w-3xl shadow-2xl relative flex flex-col max-h-[90vh]">
        {/* Header */}
        <div className="p-4 border-b flex justify-between items-center bg-indigo-700 text-white rounded-t-lg">
          <div>
            <h3 className="text-xl font-bold">📄 Generar Recipe Médico</h3>
            <p className="text-indigo-200 text-sm">Vinculado a Telemedicina (Sesión: {sessionId?.substring(0, 8)}...)</p>
          </div>
          <button onClick={onClose} className="text-white hover:text-gray-200 text-2xl font-bold">×</button>
        </div>

        {/* Body Scrollable */}
        <div className="p-6 overflow-y-auto flex-grow">

          {/* 1. Datos del Paciente (Solo lectura) */}
          <div className="bg-gray-50 p-4 rounded-lg border border-gray-200 mb-6">
            <h4 className="font-bold text-gray-700 mb-2 text-sm uppercase">Datos del Paciente</h4>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-xs text-gray-500">Nombre</label>
                <p className="font-medium text-gray-900">{patientData?.name || 'N/A'}</p>
              </div>
              <div>
                <label className="block text-xs text-gray-500">Cédula</label>
                <p className="font-medium text-gray-900">{patientData?.cedula || 'N/A'}</p>
              </div>
            </div>
          </div>

          {/* 2. Tipo de Recipe */}
          <div className="mb-6">
            <label className="block text-sm font-medium text-gray-700 mb-2">Tipo de Recipe</label>
            <div className="flex gap-4">
              <label className={`flex-1 cursor-pointer border-2 rounded-lg p-3 flex items-center justify-center gap-2 transition ${prescriptionType === 'medication' ? 'border-indigo-600 bg-indigo-50 text-indigo-700' : 'border-gray-200 hover:border-gray-300'}`}>
                <input type="radio" name="type" value="medication" checked={prescriptionType === 'medication'} onChange={(e) => setPrescriptionType(e.target.value)} className="hidden" />
                <span className="text-xl">💊</span>
                <span className="font-medium">Medicamentos</span>
              </label>
              <label className={`flex-1 cursor-pointer border-2 rounded-lg p-3 flex items-center justify-center gap-2 transition ${prescriptionType === 'paraclinical' ? 'border-indigo-600 bg-indigo-50 text-indigo-700' : 'border-gray-200 hover:border-gray-300'}`}>
                <input type="radio" name="type" value="paraclinical" checked={prescriptionType === 'paraclinical'} onChange={(e) => setPrescriptionType(e.target.value)} className="hidden" />
                <span className="text-xl">🔬</span>
                <span className="font-medium">Estudios Paraclínicos</span>
              </label>
            </div>
          </div>

          {/* 3. Contenido Dinámico */}
          {prescriptionType === 'medication' ? (
            <div className="space-y-4">
              <h4 className="font-bold text-gray-700 border-b pb-2">Detalle de Medicamentos e Indicaciones</h4>
              {medications.map((med, index) => (
                <div key={index} className="bg-gray-50 p-4 rounded-lg border border-gray-200 relative">
                  <button
                    onClick={() => handleRemoveMedication(index)}
                    className="absolute top-2 right-2 text-red-500 hover:text-red-700 font-bold"
                    title="Eliminar medicamento"
                  >
                    ✕
                  </button>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3">

                    {/* ✅ AQUI VA EL AUTOCOMPLETADO (REEMPLAZA EL INPUT ANTIGUO) */}
                    <PrincipioActivoAutocomplete
                      value={med.name}
                      onChange={(val) => handleMedChange(index, 'name', val)}
                      backendUrl={backendUrl} // ✅ Usar el prop correcto
                      placeholder="Escribe para buscar (ej: Paracetamol)..."
                      className="w-full"
                    />

                    <input
                      type="text" placeholder="Dosis (Ej: 1 tableta cada 8h)"
                      value={med.dosage} onChange={(e) => handleMedChange(index, 'dosage', e.target.value)}
                      className="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500"
                    />
                    <input
                      type="text" placeholder="Duración (Ej: 7 días)"
                      value={med.duration} onChange={(e) => handleMedChange(index, 'duration', e.target.value)}
                      className="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500"
                    />
                    <textarea
                      placeholder="Indicaciones adicionales"
                      value={med.instructions} onChange={(e) => handleMedChange(index, 'instructions', e.target.value)}
                      className="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500" rows="2"
                    />
                  </div>

                  {/* ✅ CHECKBOX PARA RECIPE ESPECIAL */}
                  <div className="mt-3 pt-3 border-t border-gray-200">
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={med.isSpecial}
                        onChange={() => handleSpecialToggle(index)}
                        className="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500"
                      />
                      <span className="text-sm font-medium text-gray-700">
                        🚨 Requiere Recipe Especial (Antibiótico/Psicotrópico)
                      </span>
                    </label>
                    <p className="text-xs text-gray-500 mt-1 ml-6">
                      Los medicamentos marcados se enviarán en un recipe aparte.
                    </p>
                  </div>
                </div>
              ))}
              <button onClick={handleAddMedication} className="text-indigo-600 hover:text-indigo-800 font-medium text-sm flex items-center gap-1">
                ➕ Agregar otro medicamento
              </button>
            </div>
          ) : (
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">Orden de Estudios / Paraclínicos</label>
              <textarea
                value={paraclinicalText}
                onChange={(e) => setParaclinicalText(e.target.value)}
                placeholder="Escriba aquí los estudios solicitados (Ej: Hemograma completo, Rayos X de tórax...)"
                className="w-full p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500"
                rows="8"
              />
            </div>
          )}

          {/* 4. Correo Adicional */}
          <div className="mt-6 pt-4 border-t">
            <label className="block text-sm font-medium text-gray-700 mb-1">Enviar copia a (Email adicional)</label>
            <input
              type="email"
              value={additionalEmail}
              onChange={(e) => setAdditionalEmail(e.target.value)}
              placeholder="otro@email.com (Opcional)"
              className="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500"
            />
          </div>

        </div>

        {/* Footer */}
        <div className="p-4 border-t bg-gray-50 flex justify-end gap-3 rounded-b-lg">
          <button onClick={onClose} className="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium transition">
            Cancelar
          </button>
          <button
            onClick={generatePreview}
            disabled={isSending}
            className="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
          >
            {isSending ? (
              <>
                <svg className="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                  <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Generando...
              </>
            ) : (
              '👁️ Generar Vista Previa'
            )}
          </button>
        </div>

      </div>
    </div>
  );
};

export default PrescriptionModal;
