# .env.example - Copia este archivo a .env y configura tus variables
VITE_APP_ENV=development
VITE_BACKEND_URL=/api
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_auth_domain
